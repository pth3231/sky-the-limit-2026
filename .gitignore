# Sky's The Limit 2026 hackathon data: licensed, must not be committed
stl-hackathon-2026-grid-starter/
*.zst
*.jsonl

# Oracle's Elixir CSV source data: downloaded locally, never committed
oracle-elixir-dataset/
# Decompressed copies or extracts built from the data (adjust to your project)
*.parquet
*.sqlite
*.duckdb

# Local Python environment
.venv/

# Local environment settings (examples remain shareable)
.env
.env.*
!.env.example

# Python and pytest caches
__pycache__/
.pytest_cache/
.ruff_cache/

# Derived pipeline outputs (GRID data)
backend/.derived/
# Model weights trained on GRID data, wherever they are written
*.pt
*.pth
model_metrics.json

# AI tool artifacts
.impeccable/
.playwright-mcp/

# .junie/ is intentionally NOT ignored: Cloud9 asked participants to commit it (and .air/, .run/
# if present) as supporting evidence of JetBrains tool use in the hackathon Discord, as long as it
# holds no sensitive info. Check new .junie/ content for secrets before committing.

# Frontend build output
frontend/.next/
frontend/node_modules/
